# Environment Variables Template
# Copy this file to .env and provide your API keys if available.
# (The system operates seamlessly in deterministic fallback mode even without any keys).

# GitHub Enrichment (Optional, helps avoid public rate limits: 60 req/hour -> 5000 req/hour)
GITHUB_TOKEN=your_github_personal_access_token_here

# LLM Providers for Semantic Evaluation (Optional - pick any or none)
# Groq (Fast inference, recommended)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
